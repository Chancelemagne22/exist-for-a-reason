# Copy this file to .env and fill in your own values.
# Never commit your actual .env file.

# Your Modal Dedicated Endpoint URL — COPY EXACTLY from dashboard Endpoints tab → efar-coder → copy icon.
# Do NOT guess it: https://<workspace>--efar-coder.modal.run is WRONG (404 "invalid function call").
# Paste the full copied value here (bare host only, without /v1/chat/completions — code appends it).
MODAL_ENDPOINT_URL=
# Legacy DIY (`modal deploy modal_app.py`) used --efar-serve.modal.run — keep old value for rollback.

# Proxy token for Dedicated Endpoint (required — `modal workspace proxy-tokens create`).
# Format: wk-<id>.ws-<secret> — single dot-joined string used as Bearer token. Never commit.
MODAL_PROXY_TOKEN=

# Source of truth for model is dashboard Endpoints -> efar-coder -> Quickstart request example.
# Currently "Qwen/Qwen3.5-4B". For rollback to DIY, set MODAL_MODEL=roblox-coder.
MODAL_MODEL=Qwen/Qwen3.5-4B

# Must match --max-model-len in modal_app.py (default 16384).
# Keep in sync or token-budget trimming in rag/app.py and rag/ask.py will diverge.
MAX_MODEL_LEN=16384

# Only needed once the frontend is built - leave blank for now
NEXT_PUBLIC_API_URL=
# Supabase Postgres URL — pick ONE format (do not mix host + port):
#   Pooler (recommended for Streamlit/CLI, IPv4): postgresql://postgres.<ref>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres
#   Direct (db host): postgresql://postgres@db.<ref>.supabase.co:5432/postgres
# Pooler host MUST use :6543 (not :5432) or you get "tenant/user not found".
SUPABASE_DB_URL=

# Optional: Hugging Face token to avoid FastEmbed rate limits (https://huggingface.co/settings/tokens)
# HF_TOKEN=
# Windows only: silences symlink warning for fastembed cache (or enable Developer Mode / run as admin)
# HF_HUB_DISABLE_SYMLINKS_WARNING=1