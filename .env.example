# Copy this file to .env and fill in your own values.
# Never commit your actual .env file.

# Your deployed Modal endpoint URL (printed after `modal deploy modal_app.py`)
# Example: https://your-workspace--efar-serve.modal.run
MODAL_ENDPOINT_URL=

# Must match --max-model-len in modal_app.py (default 16384).
# Keep in sync or token-budget trimming in rag/app.py and rag/ask.py will diverge.
MAX_MODEL_LEN=16384

# Only needed once the frontend is built - leave blank for now
NEXT_PUBLIC_API_URL=
SUPABASE_DB_URL=